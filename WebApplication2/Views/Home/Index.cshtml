@{
    ViewData["Title"] = "Vehicle Service Center";
}

<div class="service-center-page">
    <h1 class="display-5 mb-3">Vehicle Service Center</h1>
    <p class="lead mb-4">View mechanic IDs and service records. This information is public and visible to all visitors.</p>

    <ul class="nav nav-tabs" id="serviceCenterTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="mechanics-tab" data-bs-toggle="tab" data-bs-target="#mechanics" type="button" role="tab" aria-controls="mechanics" aria-selected="true">
                Mechanic IDs
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="records-tab" data-bs-toggle="tab" data-bs-target="#records" type="button" role="tab" aria-controls="records" aria-selected="false">
                Service Records (Public)
            </button>
        </li>
    </ul>

    <div class="tab-content border border-top-0 rounded-bottom p-3 p-md-4 bg-white shadow-sm" id="serviceCenterTabsContent">
        <div class="tab-pane fade show active" id="mechanics" role="tabpanel" aria-labelledby="mechanics-tab" tabindex="0">
            <h2 class="h4">Mechanic Directory</h2>
            <p class="text-muted">Assigned internal mechanic IDs.</p>
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Mechanic ID</th>
                            <th>Name</th>
                            <th>Specialty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>MEC-1001</td>
                            <td>Jordan Lee</td>
                            <td>Engine Diagnostics</td>
                        </tr>
                        <tr>
                            <td>MEC-1002</td>
                            <td>Riley Carter</td>
                            <td>Brake Systems</td>
                        </tr>
                        <tr>
                            <td>MEC-1003</td>
                            <td>Casey Morgan</td>
                            <td>Electrical Repair</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="records" role="tabpanel" aria-labelledby="records-tab" tabindex="0">
            <h2 class="h4">Public Service Records</h2>
            <p class="text-muted">These records are available to everyone, including non-developer accounts and guest visitors.</p>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Record #</th>
                            <th>Vehicle</th>
                            <th>Service</th>
                            <th>Mechanic ID</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>SR-22051</td>
                            <td>2018 Honda Civic</td>
                            <td>Oil Change + Filter</td>
                            <td>MEC-1001</td>
                            <td>May 10, 2026</td>
                        </tr>
                        <tr>
                            <td>SR-22052</td>
                            <td>2021 Toyota Camry</td>
                            <td>Front Brake Pad Replacement</td>
                            <td>MEC-1002</td>
                            <td>May 11, 2026</td>
                        </tr>
                        <tr>
                            <td>SR-22053</td>
                            <td>2019 Ford Escape</td>
                            <td>Battery + Alternator Check</td>
                            <td>MEC-1003</td>
                            <td>May 13, 2026</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

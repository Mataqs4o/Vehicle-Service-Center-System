@{
    ViewData["Title"] = "Vehicle Service Center";
}

<section class="landing-hero rounded-4 p-4 p-md-5 text-white mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-6">
            <h1 class="display-4 fw-bold">Vehicle Service Center</h1>
            <p class="lead">Book appointments, track vehicle service history, and stay road-ready with confidence.</p>
            <a class="btn btn-light btn-lg" asp-controller="ServiceAppointments" asp-action="Create">Book Appointment</a>
        </div>
        <div class="col-lg-6">
            <img class="img-fluid rounded-4 shadow floating-car" src="https://images.unsplash.com/photo-1493238792000-8113da705763?auto=format&fit=crop&w=1200&q=80" alt="Vehicle service center" />
        </div>
    </div>
</section>

<section class="row g-4 text-center">
    <div class="col-md-4">
        <div class="feature-card h-100 p-4 rounded-4">
            <h3>Quick Booking</h3>
            <p>Schedule repairs and maintenance in under a minute.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100 p-4 rounded-4">
            <h3>Trusted Mechanics</h3>
            <p>Skilled technicians for diagnostics, repair, and preventive care.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card h-100 p-4 rounded-4">
            <h3>Service History</h3>
            <p>Keep a clean and organized maintenance timeline for every vehicle.</p>
        </div>
    </div>
</section>

@{
    ViewData["Title"] = "Vehicle Service Center Models";
}

<div class="text-center mb-4">
    <h1 class="display-5">Vehicle Service Center Data Models</h1>
    <p class="text-muted">Switch tabs to view the model fields.</p>
</div>

<ul class="nav nav-tabs" id="modelTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="vehicle-tab" data-bs-toggle="tab" data-bs-target="#vehicle" type="button" role="tab" aria-controls="vehicle" aria-selected="true">Vehicle</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="service-record-tab" data-bs-toggle="tab" data-bs-target="#service-record" type="button" role="tab" aria-controls="service-record" aria-selected="false">ServiceRecord</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="mechanic-tab" data-bs-toggle="tab" data-bs-target="#mechanic" type="button" role="tab" aria-controls="mechanic" aria-selected="false">Mechanic</button>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-4" id="modelTabsContent">
    <div class="tab-pane fade show active" id="vehicle" role="tabpanel" aria-labelledby="vehicle-tab" tabindex="0">
        <h3>Vehicle</h3>
        <ul>
            <li><strong>VehicleId</strong> (int): A unique identifier for the vehicle.</li>
            <li><strong>Make</strong> (string): The make of the vehicle.</li>
            <li><strong>Model</strong> (string): The model of the vehicle.</li>
            <li><strong>Year</strong> (int): The year of manufacture.</li>
            <li><strong>CustomerId</strong> (int): The identifier for the owner of the vehicle.</li>
            <li><strong>ServiceRecords</strong> (ICollection&lt;ServiceRecord&gt;): A list of service records associated with the vehicle.</li>
        </ul>
    </div>

    <div class="tab-pane fade" id="service-record" role="tabpanel" aria-labelledby="service-record-tab" tabindex="0">
        <h3>ServiceRecord</h3>
        <ul>
            <li><strong>ServiceRecordId</strong> (int): A unique identifier for the service record.</li>
            <li><strong>Date</strong> (DateTime): The date of the service.</li>
            <li><strong>VehicleId</strong> (int): The identifier for the vehicle serviced.</li>
            <li><strong>Description</strong> (string): A description of the service performed.</li>
            <li><strong>Cost</strong> (decimal): The cost of the service.</li>
        </ul>
    </div>

    <div class="tab-pane fade" id="mechanic" role="tabpanel" aria-labelledby="mechanic-tab" tabindex="0">
        <h3>Mechanic</h3>
        <ul>
            <li><strong>MechanicId</strong> (int): A unique identifier for the mechanic.</li>
            <li><strong>FirstName</strong> (string): The mechanic's first name.</li>
            <li><strong>LastName</strong> (string): The mechanic's last name.</li>
            <li><strong>Specialization</strong> (string): The area of specialization within vehicle service.</li>
        </ul>
    </div>
</div>

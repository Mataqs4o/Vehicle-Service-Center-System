@model WebApplication2.ViewModels.ServiceAppointmentViewModel
@{
    ViewData["Title"] = "Book Service Appointment";
}

<section class="hero-card mb-4 p-4 p-md-5 rounded-4 text-white">
    <h2 class="display-6 fw-bold">Book Service Appointment</h2>
    <p class="mb-0">Choose your vehicle, preferred date, and service details. We'll handle the rest.</p>
</section>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

@if (Model.PriceEstimates.Any())
{
    <div class="card mb-3">
        <div class="card-header">Approximate prices from booked repairs</div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead><tr><th>Repair Type</th><th>Approx. Price</th></tr></thead>
                <tbody>
                @foreach (var estimate in Model.PriceEstimates)
                {
                    <tr><td>@estimate.RepairType</td><td>@estimate.ApproximatePrice.ToString("C")</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<form asp-action="Create" method="post" class="row g-3">
    <div class="col-md-4">
        <label asp-for="VehicleId" class="form-label"></label>
        <select asp-for="VehicleId" asp-items="Model.AvailableVehicles" class="form-select">
            <option value="">Select your vehicle</option>
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EstimatedCost" class="form-label"></label>
        <input asp-for="EstimatedCost" class="form-control" />
        <span asp-validation-for="EstimatedCost" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-12">
        <button class="btn btn-primary btn-lg px-4" type="submit">Book Appointment</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
